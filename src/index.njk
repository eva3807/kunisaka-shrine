    <script>
        // Loading screen
        window.addEventListener('load', () => {
            const loader = document.getElementById('loader');
            loader.style.opacity = '0';
            setTimeout(() => loader.style.display = 'none', 1000);
        });

        // スマホ用メニューの開閉
        (function () {
            const toggle = document.getElementById('navToggle');
            const overlay = document.getElementById('navOverlay');
            if (!toggle || !overlay) return;

            function setOpen(open) {
                document.body.classList.toggle('menu-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
            }

            toggle.addEventListener('click', function () {
                setOpen(!document.body.classList.contains('menu-open'));
            });
            // 項目を選んだら閉じる
            overlay.querySelectorAll('a').forEach(function (a) {
                a.addEventListener('click', function () { setOpen(false); });
            });
            // Escキーでも閉じる
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') setOpen(false);
            });
            // 画面を横向きにするなどで広くなったら閉じる
            window.addEventListener('resize', function () {
                if (window.innerWidth > 768) setOpen(false);
            });
        })();

        // Parallax & Navbar
        window.addEventListener('scroll', () => {
            const scroll = window.scrollY;
            const heroBg = document.getElementById('heroBg');
            const nav = document.getElementById('navbar');

            // スマホでは視差効果を弱めて動きの重さを抑える
            const parallaxRate = window.innerWidth <= 768 ? 0.15 : 0.4;
            heroBg.style.transform = `translateY(${scroll * parallaxRate}px)`;

            if (scroll > 100) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');

            // Scroll Reveal
            document.querySelectorAll('.reveal').forEach(el => {
                const rect = el.getBoundingClientRect();
                if (rect.top < window.innerHeight - 100) el.classList.add('active');
            });
        });

        // FAQ Accordion
        document.querySelectorAll('.faq-question').forEach(q => {
            q.addEventListener('click', () => {
                const answer = q.nextElementSibling;
                const isOpen = answer.style.display === 'block';
                document.querySelectorAll('.faq-answer').forEach(a => a.style.display = 'none');
                answer.style.display = isOpen ? 'none' : 'block';
            });
        });

        // ============================================================
        //  行事カレンダー
        //  SHRINE_EVENTS（ビルド時に埋め込み）から月表示と「次の行事」を作る
        // ============================================================
        (function () {
            const events = (typeof SHRINE_EVENTS !== 'undefined') ? SHRINE_EVENTS : [];
            const grid = document.getElementById('calGrid');
            const titleEl = document.getElementById('calTitle');
            const detailEl = document.getElementById('calDetail');
            const upcomingEl = document.getElementById('upcomingList');
            if (!grid) return;

            const DOW = ['日', '月', '火', '水', '木', '金', '土'];
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            let viewYear = today.getFullYear();
            let viewMonth = today.getMonth() + 1; // 1〜12
            let selectedKey = null;

            // 同じ日に同名の行事が「年中行事」と「今年の予定」の両方にある場合は、
            // 時刻・場所まで入っている「今年の予定」の方を残す
            function dedupe(list) {
                const onceNames = new Set(
                    list.filter(function (e) { return e.kind === 'once'; })
                        .map(function (e) { return e.name; })
                );
                return list.filter(function (e) {
                    return e.kind === 'once' || !onceNames.has(e.name);
                });
            }

            // 指定の年月日に該当する行事を集める
            function eventsOn(y, m, d) {
                return dedupe(events.filter(function (e) {
                    if (e.kind === 'once') return e.year === y && e.month === m && e.day === d;
                    // 毎年の行事は日付まで決まっているものだけ日付に紐づける
                    return e.day && e.month === m && e.day === d;
                }));
            }

            // 日付が決まっていない「○月のみ」の年中行事
            function monthOnlyEvents(m) {
                return events.filter(function (e) {
                    return e.kind === 'annual' && e.month === m && !e.day;
                });
            }

            function renderCalendar() {
                titleEl.textContent = viewYear + '年 ' + viewMonth + '月';
                grid.innerHTML = '';

                DOW.forEach(function (name, i) {
                    const cell = document.createElement('div');
                    cell.className = 'cal-dow' + (i === 0 ? ' sun' : i === 6 ? ' sat' : '');
                    cell.textContent = name;
                    grid.appendChild(cell);
                });

                const first = new Date(viewYear, viewMonth - 1, 1);
                const daysInMonth = new Date(viewYear, viewMonth, 0).getDate();

                // 月初までの空きマス
                for (let i = 0; i < first.getDay(); i++) {
                    const blank = document.createElement('div');
                    blank.className = 'cal-cell empty';
                    grid.appendChild(blank);
                }

                for (let d = 1; d <= daysInMonth; d++) {
                    const dow = new Date(viewYear, viewMonth - 1, d).getDay();
                    const dayEvents = eventsOn(viewYear, viewMonth, d);
                    const key = viewYear + '-' + viewMonth + '-' + d;

                    const cell = document.createElement('div');
                    cell.className = 'cal-cell' + (dow === 0 ? ' sun' : dow === 6 ? ' sat' : '');
                    if (viewYear === today.getFullYear() && viewMonth === today.getMonth() + 1 && d === today.getDate()) {
                        cell.classList.add('today');
                    }
                    if (selectedKey === key) cell.classList.add('selected');

                    const num = document.createElement('span');
                    num.className = 'cal-num';
                    num.textContent = d;
                    cell.appendChild(num);

                    dayEvents.forEach(function (e) {
                        const tag = document.createElement('span');
                        tag.className = 'cal-tag' + (e.category !== '祭典' ? ' notice' : '');
                        tag.textContent = e.name;
                        tag.title = e.name;
                        cell.appendChild(tag);
                    });

                    if (dayEvents.length > 0) {
                        cell.classList.add('has-event');
                        cell.setAttribute('role', 'button');
                        cell.setAttribute('tabindex', '0');
                        const show = function () {
                            selectedKey = key;
                            renderCalendar();
                            showDetail(viewYear, viewMonth, d, dayEvents);
                        };
                        cell.addEventListener('click', show);
                        cell.addEventListener('keydown', function (ev) {
                            if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); show(); }
                        });
                    }

                    grid.appendChild(cell);
                }
            }

            function showDetail(y, m, d, list) {
                let html = '<p class="meta">' + y + '年' + m + '月' + d + '日</p>';
                list.forEach(function (e) {
                    html += '<h4>' + escapeHtml(e.name);
                    if (e.reading) html += ' <small>（' + escapeHtml(e.reading) + '）</small>';
                    html += '</h4>';
                    const meta = [];
                    if (e.time) meta.push(e.time);
                    if (e.place) meta.push(e.place);
                    if (meta.length) html += '<p class="meta">' + escapeHtml(meta.join('　／　')) + '</p>';
                    if (e.body) html += '<p>' + escapeHtml(e.body) + '</p>';
                });
                detailEl.innerHTML = html;
            }

            // 今日以降の予定を近い順に取り出す
            function buildUpcoming(limit) {
                const list = [];

                events.forEach(function (e) {
                    if (e.kind === 'once') {
                        const dt = new Date(e.year, e.month - 1, e.day);
                        if (dt >= today) list.push({ date: dt, event: e, approx: false });
                        return;
                    }
                    // 毎年の行事は「次に来る回」を計算する
                    const day = e.day || 1;
                    let dt = new Date(today.getFullYear(), e.month - 1, day);
                    if (dt < today) dt = new Date(today.getFullYear() + 1, e.month - 1, day);
                    list.push({ date: dt, event: e, approx: !e.day });
                });

                // 日付順。同じ日なら、時刻・場所まで入っている「今年の予定」を先に置く
                list.sort(function (a, b) {
                    if (a.date - b.date !== 0) return a.date - b.date;
                    return (a.event.kind === 'once' ? 0 : 1) - (b.event.kind === 'once' ? 0 : 1);
                });

                // 同名の行事は1件だけ残す（年中行事と今年の予定の重複を防ぐ）
                const seen = new Set();
                return list.filter(function (it) {
                    if (seen.has(it.event.name)) return false;
                    seen.add(it.event.name);
                    return true;
                }).slice(0, limit);
            }

            function renderUpcoming() {
                const items = buildUpcoming(4);
                if (items.length === 0) {
                    upcomingEl.innerHTML = '<p class="empty-note">予定はありません。</p>';
                    return;
                }
                upcomingEl.innerHTML = items.map(function (it) {
                    const e = it.event;
                    const sub = [];
                    if (it.approx) sub.push('日程は月内で調整');
                    if (e.time) sub.push(e.time);
                    if (e.place) sub.push(e.place);
                    const cat = (e.category && e.category !== '祭典')
                        ? '<span class="up-cat">' + escapeHtml(e.category) + '</span>' : '';
                    // 年をまたぐ予定は「2027年 1月」のように年も示す
                    const yearLabel = it.date.getFullYear() !== today.getFullYear()
                        ? it.date.getFullYear() + '年 ' : '';
                    return '' +
                        '<div class="up-item">' +
                          '<div class="up-date">' +
                            '<span class="m">' + yearLabel + (it.date.getMonth() + 1) + '月</span>' +
                            '<span class="d">' + (it.approx ? '―' : it.date.getDate()) + '</span>' +
                          '</div>' +
                          '<div class="up-body">' +
                            '<span class="name">' + escapeHtml(e.name) + '</span>' + cat +
                            (sub.length ? '<div class="sub">' + escapeHtml(sub.join('　／　')) + '</div>' : '') +
                          '</div>' +
                        '</div>';
                }).join('');
            }

            function escapeHtml(s) {
                return String(s).replace(/[&<>"']/g, function (c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            document.getElementById('calPrev').addEventListener('click', function () {
                viewMonth--; if (viewMonth < 1) { viewMonth = 12; viewYear--; }
                selectedKey = null; renderCalendar();
            });
            document.getElementById('calNext').addEventListener('click', function () {
                viewMonth++; if (viewMonth > 12) { viewMonth = 1; viewYear++; }
                selectedKey = null; renderCalendar();
            });

            renderCalendar();
            renderUpcoming();
        })();

        // 3D Card Hover Effect（マウスのある端末のみ。スマホでは傾きが残るため無効化）
        const hasHover = window.matchMedia('(hover: hover)').matches;
        if (hasHover) {
            document.querySelectorAll('.card').forEach(card => {
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    const x = (e.clientX - rect.left) / rect.width - 0.5;
                    const y = (e.clientY - rect.top) / rect.height - 0.5;
                    card.style.transform = `translateY(-15px) rotateX(${y * -10}deg) rotateY(${x * 10}deg)`;
                });
                card.addEventListener('mouseleave', () => {
                    card.style.transform = `translateY(0) rotateX(0) rotateY(0)`;
                });
            });
        }
    </script>
</body>
</html>
