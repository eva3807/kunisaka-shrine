        <link rel="icon" type="image/svg+xml" href="favicon.svg" />    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --shuiro: #a52a2a;      /* 朱色 */
            --kin: #b09a5b;        /* 金色 */
            --washiiro: #f9f7f0;    /* 和紙色 */
            --sumiiro: #1c1c1c;     /* 墨色 */
            --gold-grad: linear-gradient(135deg, #b09a5b 0%, #f7ef8a 50%, #b09a5b 100%);
            --glass: rgba(249, 247, 240, 0.9);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Noto Serif JP', serif;
            background-color: var(--washiiro);
            color: var(--sumiiro);
            line-height: 1.8;
            overflow-x: hidden;
        }

        /* --- Loading Animation --- */
        #loader {
            position: fixed; width: 100%; height: 100%; background: var(--sumiiro);
            z-index: 9999; display: flex; justify-content: center; align-items: center;
            transition: 1s ease;
        }
        .loader-logo { color: var(--kin); font-size: 2rem; letter-spacing: 1rem; animation: pulse 2s infinite; }
        @keyframes pulse { 0% { opacity: 0.5; } 50% { opacity: 1; } 100% { opacity: 0.5; } }

        /* --- Navigation --- */
        nav {
            position: fixed; top: 0; width: 100%; padding: 25px 50px;
            display: flex; justify-content: space-between; align-items: center;
            z-index: 1000; transition: 0.5s;
        }
        nav.scrolled {
            background: var(--glass); padding: 15px 50px;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1); border-bottom: 2px solid var(--kin);
        }
        .logo { font-size: 1.8rem; font-weight: 900; color: var(--shuiro); text-decoration: none; letter-spacing: 0.3rem; }
        .nav-links { display: flex; list-style: none; }
        .nav-links li { margin-left: 25px; }
        .nav-links a { text-decoration: none; color: var(--sumiiro); font-weight: 700; font-size: 0.85rem; transition: 0.3s; }
        nav:not(.scrolled) .nav-links a { color: #fff; text-shadow: 1px 1px 3px rgba(0,0,0,0.5); }
        .nav-links a:hover { color: var(--shuiro); }

        /* --- Hero Section --- */
        .hero {
            height: 100vh; display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden; background: #000;
        }
        .hero-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 120%;
            background-size: cover; background-position: center; z-index: 1;
        }
        .hero-content { position: relative; z-index: 2; text-align: center; color: #fff; }
        .hero-content h1 {
            font-size: clamp(3rem, 10vw, 6rem); letter-spacing: 1.5rem; margin-bottom: 20px;
            background: var(--gold-grad); -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            filter: drop-shadow(2px 2px 10px rgba(0,0,0,0.5));
        }
        .hero-content p { font-size: 1.2rem; letter-spacing: 0.5rem; }

        /* --- Common Section Styling --- */
        section { padding: 120px 10%; position: relative; }
        .section-header { text-align: center; margin-bottom: 80px; }
        .section-header span { color: var(--kin); font-weight: 700; letter-spacing: 0.3rem; display: block; margin-bottom: 10px; }
        .section-header h2 { font-size: 2.8rem; color: var(--shuiro); position: relative; }

        /* --- History Timeline --- */
        .history-container { display: flex; flex-wrap: wrap; gap: 50px; }
        .history-text { flex: 1.5; }
        .history-timeline { flex: 1; border-left: 2px solid var(--kin); padding-left: 30px; }
        .timeline-item { position: relative; margin-bottom: 40px; }
        .timeline-item::before {
            content: ""; position: absolute; left: -41px; top: 5px;
            width: 20px; height: 20px; background: var(--shuiro); border-radius: 50%;
            box-shadow: 0 0 10px var(--kin);
        }
        .timeline-year { font-weight: 900; color: var(--shuiro); font-size: 1.3rem; display: block; }

        /* --- Cards & Grid --- */
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
        .card {
            background: #fff; padding: 40px; border: 1px solid rgba(176,154,91,0.2);
            transition: 0.5s; position: relative; overflow: hidden;
        }
        .card:hover {
            transform: translateY(-15px) rotateX(5deg);
            box-shadow: 0 20px 40px rgba(176,154,91,0.2);
            border-color: var(--kin);
        }
        .card h3 { color: var(--shuiro); margin-bottom: 20px; border-bottom: 1px solid var(--kin); padding-bottom: 10px; }

        /* --- Event Table --- */
        .event-table { width: 100%; border-collapse: collapse; background: #fff; }
        .event-table th, .event-table td { padding: 25px; border-bottom: 1px solid #eee; text-align: left; }
        .event-table th { color: var(--shuiro); width: 25%; font-size: 1.1rem; }

        /* --- FAQ Accordion --- */
        .faq-item { background: #fff; margin-bottom: 10px; border: 1px solid #ddd; border-radius: 5px; }
        .faq-question { padding: 20px; cursor: pointer; font-weight: 700; display: flex; justify-content: space-between; align-items: center; }
        .faq-answer { padding: 0 20px 20px; display: none; color: #555; border-top: 1px solid #eee; padding-top: 20px; }

        /* --- Access Info --- */
        .access-container { display: flex; flex-wrap: wrap; gap: 40px; background: #fff; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
        .access-info { flex: 1; min-width: 300px; }
        .access-map { flex: 1.5; min-width: 300px; height: 450px; border: 4px solid var(--kin); }

        /* --- Footer --- */

          /* --- Media Section --- */
  .media-grid { display: flex; flex-wrap: wrap; gap: 40px; }
  .media-card { flex: 1 1 400px; }
  .media-card img { width: 100%; border-radius: 4px; box-shadow: 0 5px 15px rgba(0,0,0,0.15); }

footer { background: var(--sumiiro); color: var(--washiiro); padding: 100px 10% 50px; text-align: center; }
        .footer-logo { font-size: 2.5rem; color: var(--kin); margin-bottom: 20px; letter-spacing: 0.5rem; }

        /* --- Reveal Animations --- */
        .reveal { opacity: 0; transform: translateY(50px); transition: 1.2s cubic-bezier(0.17, 0.67, 0.83, 0.67); }
        .reveal.active { opacity: 1; transform: translateY(0); }

        /* --- お知らせ / 授与品 / 御朱印（GUI管理セクション） --- */
        .news-list { max-width: 800px; margin: 0 auto; }
        .news-item { background: #fff; border: 1px solid rgba(176,154,91,0.3); border-left: 5px solid var(--kin); padding: 25px 30px; margin-bottom: 15px; }
        .news-item.is-important { border-left-color: var(--shuiro); }
        .news-date { color: var(--kin); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.1rem; }
        .news-title { color: var(--shuiro); font-size: 1.2rem; font-weight: 700; margin: 5px 0 10px; }
        .news-badge { display: inline-block; background: var(--shuiro); color: #fff; font-size: 0.7rem; padding: 2px 10px; border-radius: 3px; margin-left: 10px; vertical-align: middle; }
        .jyoyohin-img { height: 200px; background-size: cover; background-position: center; margin-bottom: 20px; background-color: #f0ede2; }
        .jyoyohin-meta { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px; }
        .tag { display: inline-block; font-size: 0.75rem; padding: 3px 12px; border-radius: 3px; background: var(--kin); color: #fff; }
        .price { font-weight: 900; color: var(--shuiro); font-size: 1.1rem; }
        .period { font-size: 0.8rem; color: #777; }
        .goshuin-box { max-width: 900px; margin: 0 auto; background: #fff; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
        .goshuin-box dl { display: grid; grid-template-columns: 140px 1fr; gap: 10px 20px; }
        .goshuin-box dt { font-weight: 900; color: var(--shuiro); }
        .empty-note { text-align: center; color: #999; }

        @media (max-width: 768px) {
            nav { padding: 15px 20px; }
            .nav-links { display: none; }
            section { padding: 80px 5%; }
            .hero-content h1 { font-size: 3rem; }
            .goshuin-box dl { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <div id="loader"><div class="loader-logo">國坂神社</div></div>

    <nav id="navbar">
        <a href="#" class="logo">國坂神社</a>
        <ul class="nav-links">
            <li><a href="#news">お知らせ</a></li>
            <li><a href="#history">由緒</a></li>
            <li><a href="#deity">祭神</a></li>
            <li><a href="#precincts">境内</a></li>
            <li><a href="#events">行事</a></li>
            <li><a href="#jyoyohin">授与品</a></li>
            <li><a href="#goshuin">御朱印</a></li>
            <li><a href="#access">交通</a></li>
            <li><a href="#media">作品</a></li>
        </ul>
    </nav>

    <div class="hero">
        <div class="hero-bg" id="heroBg" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('{{ settings.hero.image | asset }}');"></div>
        <div class="hero-content">
            <p>{{ settings.hero.tagline_top }}</p>
            <h1>{{ settings.hero.title }}</h1>
            <p>{{ settings.hero.tagline_bottom }}</p>
        </div>
    </div>

    <section id="news">
        <div class="section-header reveal">
            <span>NEWS</span>
            <h2>お知らせ</h2>
        </div>
        <div class="news-list reveal">
            {% set news = oshirase.items | recent %}
            {% if news.length == 0 %}
            <p class="empty-note">現在お知らせはありません。</p>
            {% endif %}
            {% for item in news %}
            <div class="news-item {% if item.important %}is-important{% endif %}">
                <span class="news-date">{{ item.date | date_ja }}</span>
                {% if item.important %}<span class="news-badge">重要</span>{% endif %}
                <div class="news-title">{{ item.title }}</div>
                <p>{{ item.body }}</p>
            </div>
            {% endfor %}
        </div>
    </section>

<section id="history">
  <div class="section-header reveal">
    <span>HISTORY</span>
    <h2>御由緒と歩み</h2>
  </div>
  <div class="history-container">
    <div class="history-text reveal">
      <p>創建は遥か古に遡ります。伝承によれば、この國坂の地に少彦名命が降臨し、人々に農耕の術と病を治す知恵を授けたことが始まりとされています。</p>
      <p style="margin-top: 20px;">中世では武将や地元有力者から督い崇敬を受け、幾多の戦乱の中でも絶えることなく社火が守り継がれました。江戸時代には「医薬の神」としての名声が中国地方一帯に広まり、疫病が流行した際には多くの人々がその神威を頼り、病気平癒を祈願したと伝えられています。明治・昭和の激動期を経ても、その伝統と格式は今もなお地域の人々によって守り継がれています。</p>
    </div>
    <div class="history-timeline reveal">
      <div class="timeline-item">
        <span class="timeline-year">837年（承和4年）</span>
        <p>『続日本後紀』に記録。従五位下を授かる。</p>
      </div>
      <div class="timeline-item">
        <span class="timeline-year">867年（貞観9年）</span>
        <p>『日本三代実録』に記録。正五位上に昇叙。</p>
      </div>
      <div class="timeline-item">
        <span class="timeline-year">927年（延長5年）</span>
        <p>『延喜式』神名帳に記載、式内社に列せられる。</p>
      </div>
      <div class="timeline-item">
        <span class="timeline-year">1524年（大永4年）頃</span>
        <p>戦火を免れ、社殿が維持された記録が残る。</p>
      </div>
    </div>
  </div>
</section>
    <section id="deity" style="background: #fff;">
        <div class="section-header reveal">
            <span>DEITY</span>
            <h2>御祭神</h2>
        </div>
        <div class="reveal" style="max-width: 1000px; margin: 0 auto; text-align: center;">
            <h3 style="color: var(--shuiro); font-size: 2rem; margin-bottom: 30px;">少彦名神 <small>(すくなひこなのかみ)</small></h3>
            <p>日本神話において大国主神と共に「国造り」を成し遂げた神。ガガイモの船に乗り、蛾の皮の着物を着た小さな神様ですが、その智慧と神力は絶大です。医薬・温泉・まじないの法を定め、人々の病を治し、鳥獣や昆虫の災いを除く術を教え広めました。また「酒造りの神」としての側面も持ち、万民の生命を育む神として崇められています。</p>

            <div class="grid" style="margin-top: 60px;">
                <div class="card">
                    <h3>病気平癒・身体健康</h3>
                    <p>医療従事者の守護神として名高く、難病平癒や手術の成功を祈る参拝者が絶えません。</p>
                </div>
                <div class="card">
                    <h3>産業開発・商売繁盛</h3>
                    <p>新たな事業の興隆や商いの繁栄を願う人々に、少彦名神の豊かな知恵を授けます。</p>
                </div>
                <div class="card">
                    <h3>厄除け・災難除け</h3>
                    <p>生活の基本である「食」の安全や、予期せぬ厄災から家庭を堅固に守護します。</p>
                </div>
            </div>
        </div>
    </section>

    <section id="precincts">
    <div class="section-header reveal">
        <span>PRECINCTS</span>
        <h2>境内案内</h2>
    </div>
    <div class="grid">
        {% for item in keidai.items | visible %}
        <div class="card reveal">
            {% if item.image %}<div style="height: 200px; background: url('{{ item.image | asset }}') center/cover; margin-bottom: 20px;"></div>{% endif %}
            <h3>{{ item.title }}</h3>
            <p>{{ item.body }}</p>
        </div>
        {% endfor %}
    </div>
</section>


    <section id="events" style="background: #fff;">
        <div class="section-header reveal">
            <span>EVENTS</span>
            <h2>年中行事</h2>
        </div>
        <div class="reveal" style="max-width: 900px; margin: 0 auto;">
            <table class="event-table">
                {% for item in gyoji.items | visible %}
                <tr>
                    <th>{{ item.when }}</th>
                    <td>
                        <strong>{{ item.name }}{% if item.reading %}（{{ item.reading }}）{% endif %}</strong><br>
                        {{ item.body }}
                    </td>
                </tr>
                {% endfor %}
            </table>
        </div>
    </section>

    <section id="jyoyohin">
        <div class="section-header reveal">
            <span>OFFERINGS</span>
            <h2>授与品のご案内</h2>
        </div>
        <div class="grid reveal">
            {% set offerings = jyoyohin.items | visible %}
            {% if offerings.length == 0 %}
            <p class="empty-note">現在ご案内できる授与品はありません。</p>
            {% endif %}
            {% for item in offerings %}
            <div class="card">
                {% if item.image %}<div class="jyoyohin-img" style="background-image: url('{{ item.image | asset }}');"></div>{% endif %}
                <div class="jyoyohin-meta">
                    {% if item.category %}<span class="tag">{{ item.category }}</span>{% endif %}
                    {% if item.price %}<span class="price">{{ item.price }}</span>{% endif %}
                </div>
                <h3>{{ item.name }}</h3>
                {% if item.period_from or item.period_to %}
                <p class="period">授与期間：{{ item.period_from | date_ja }}{% if item.period_to %} 〜 {{ item.period_to | date_ja }}{% endif %}</p>
                {% endif %}
                <p>{{ item.description }}</p>
            </div>
            {% endfor %}
        </div>
    </section>

    <section id="goshuin" style="background: #fff;">
        <div class="section-header reveal">
            <span>GOSHUIN</span>
            <h2>御朱印のご案内</h2>
        </div>
        <div class="goshuin-box reveal">
            <dl>
                <dt>初穂料</dt><dd>{{ goshuin.hatsuho }}</dd>
                <dt>受付時間</dt><dd>{{ goshuin.hours }}</dd>
                <dt>受付場所</dt><dd>{{ goshuin.place }}</dd>
                {% if goshuin.notes %}<dt>ご注意</dt><dd>{{ goshuin.notes }}</dd>{% endif %}
            </dl>
        </div>
        {% set limited = goshuin.limited | visible %}
        {% if limited.length > 0 %}
        <div class="grid reveal" style="margin-top: 50px;">
            {% for item in limited %}
            <div class="card">
                {% if item.image %}<div class="jyoyohin-img" style="background-image: url('{{ item.image | asset }}');"></div>{% endif %}
                <div class="jyoyohin-meta">
                    <span class="tag">限定</span>
                    {% if item.hatsuho %}<span class="price">{{ item.hatsuho }}</span>{% endif %}
                </div>
                <h3>{{ item.name }}</h3>
                {% if item.period %}<p class="period">頒布期間：{{ item.period }}</p>{% endif %}
                <p>{{ item.description }}</p>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    <section id="shinto" style="background: var(--sumiiro); color: #fff;">
        <div class="section-header reveal">
            <span style="color: var(--kin);">KNOWLEDGE</span>
            <h2 style="color: var(--kin);">神道と式内社</h2>
        </div>
        <div class="grid reveal">
            <div>
                <h4 style="color: var(--kin); margin-bottom: 15px;">式内社とは</h4>
                <p>927年編纂の『延喜式』神名帳に記載された神社。平安時代当時、すでに国から重要視されていた由緒正しい古社である証です。</p>
            </div>
            <div>
                <h4 style="color: var(--kin); margin-bottom: 15px;">八百万の神</h4>
                <p>自然万物に神が宿ると考える信仰。國坂神社は、この豊かな北栄の大地と歴史そのものを神聖視しています。</p>
            </div>
            <div>
                <h4 style="color: var(--kin); margin-bottom: 15px;">参拝の作法（二礼二拍手一礼）</h4>
                <ol style="padding-left: 20px; font-size: 0.9rem;">
                    <li>鳥居前で一礼し、手水舎で清める</li>
                    <li>神前で姿勢を正し、深く二回お辞儀</li>
                    <li>胸の高さで二回拍手を打つ</li>
                    <li>手を合わせ、感謝と祈りを捧げる</li>
                    <li>最後にもう一度、深く一回お辞儀</li>
                </ol>
            </div>
        </div>
    </section>

    <section id="faq">
        <div class="section-header reveal">
            <span>FAQ</span>
            <h2>よくあるご質問</h2>
        </div>
        <div class="reveal" style="max-width: 800px; margin: 0 auto;">
            {% for item in faq.items | visible %}
            <div class="faq-item">
                <div class="faq-question">{{ item.question }} <span>▼</span></div>
                <div class="faq-answer">{{ item.answer | safe }}</div>
            </div>
            {% endfor %}
        </div>
    </section>

      <!-- Media Section -->
  <section id="media">
    <div class="section-header reveal">
      <span>MEDIA</span>
      <h2>当神社がモデルとなった作品のご紹介</h2>
    </div>
    <div class="grid reveal">
      {% for item in sakuhin.items | visible %}
      <div class="card">
        {% if item.image %}
        <div style="height: 450px; background: url('{{ item.image | asset }}') center/cover; margin-bottom: 20px; border-radius: 4px; position: relative;">
          {% if item.image_caption %}<div style="position: absolute; bottom: 10px; right: 10px; background: rgba(0,0,0,0.7); color: #fff; padding: 5px 10px; font-size: 0.8rem; border-radius: 3px;">{{ item.image_caption }}</div>{% endif %}
        </div>
        {% endif %}
        <h3>{{ item.title }}</h3>
        <p>{{ item.body }}</p>
        {% if item.credit %}
        <p style="margin-top: 15px; font-size: 0.9rem; color: var(--kin);">
          {% if item.status %}<strong>{{ item.status }}</strong> | {% endif %}{{ item.credit }}
          {% if item.link_url %}<br><a href="{{ item.link_url }}" target="_blank" rel="noopener" style="color: var(--shuiro); text-decoration: underline;">{{ item.link_label or "作品公式ページへ" }}</a>{% endif %}
        </p>
        {% endif %}
        {% if item.credit_note %}<p style="margin-top: 15px; font-size: 0.85rem; color: #777;">{{ item.credit_note }}</p>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>


    <section id="access" style="background: #fff;">
        <div class="section-header reveal">
            <span>ACCESS</span>
            <h2>交通案内</h2>
        </div>
        <div class="access-container reveal">
            <div class="access-info">
                <dl>
                    <dt style="font-weight: 900; color: var(--shuiro); margin-top: 10px;">所在地</dt>
                    <dd>{{ settings.access.postal_code }} {{ settings.access.address }}</dd>
                    <dt style="font-weight: 900; color: var(--shuiro); margin-top: 20px;">電話番号</dt>
                    <dd>{{ settings.access.tel }}</dd>
                    <dt style="font-weight: 900; color: var(--shuiro); margin-top: 20px;">公共交通機関</dt>
                    <dd>{{ settings.access.train }}<br>{{ settings.access.bus }}</dd>
                    <dt style="font-weight: 900; color: var(--shuiro); margin-top: 20px;">お車でのアクセス</dt>
                    <dd>{{ settings.access.car }}</dd>
                </dl>
            </div>
            <div class="access-map">
                <iframe src="{{ settings.access.map_embed_src }}" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
            </div>
        </div>
    </section>

    <footer>
        <div class="footer-logo">國坂神社</div>
        <p style="margin-bottom: 20px; opacity: 0.8;">{{ settings.access.postal_code }} {{ settings.access.address }}</p>
        <p style="font-size: 0.8rem; opacity: 0.5;">&copy; Kunisaka Shrine. All Rights Reserved.</p>
    </footer>

    <script>
        // Loading screen
        window.addEventListener('load', () => {
            const loader = document.getElementById('loader');
            loader.style.opacity = '0';
            setTimeout(() => loader.style.display = 'none', 1000);
        });

        // Parallax & Navbar
        window.addEventListener('scroll', () => {
            const scroll = window.scrollY;
            const heroBg = document.getElementById('heroBg');
            const nav = document.getElementById('navbar');

            heroBg.style.transform = `translateY(${scroll * 0.4}px)`;

            if (scroll > 100) nav.classList.add('scrolled');
            else nav.classList.remove('scrolled');

            // Scroll Reveal
            document.querySelectorAll('.reveal').forEach(el => {
                const rect = el.getBoundingClientRect();
                if (rect.top < window.innerHeight - 100) el.classList.add('active');
            });
        });

        // FAQ Accordion
        document.querySelectorAll('.faq-question').forEach(q => {
            q.addEventListener('click', () => {
                const answer = q.nextElementSibling;
                const isOpen = answer.style.display === 'block';
                document.querySelectorAll('.faq-answer').forEach(a => a.style.display = 'none');
                answer.style.display = isOpen ? 'none' : 'block';
            });
        });

        // 3D Card Hover Effect
        document.querySelectorAll('.card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = (e.clientX - rect.left) / rect.width - 0.5;
                const y = (e.clientY - rect.top) / rect.height - 0.5;
                card.style.transform = `translateY(-15px) rotateX(${y * -10}deg) rotateY(${x * 10}deg)`;
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = `translateY(0) rotateX(0) rotateY(0)`;
            });
        });
    </script>
</body>
</html>
